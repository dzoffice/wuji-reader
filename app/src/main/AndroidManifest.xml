<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 部分小说源仍是 http 明文接口（如酷喔读书 appi.kuwo.cn），必须显式放行 -->
    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:supportsRtl="false"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <!--
          横屏适配（v0.20.0）：不再锁定 portrait，全部 Activity 跟随传感器/系统方向。
          各页面布局均已按宽扁比例核查（见各 layout 注释），无 layout-land 双份维护。
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.DetailActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ui.NovelReaderActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ui.ComicReaderActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ui.NewsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ui.ShelfActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ui.ArticleActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ui.SourceManageActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ui.SettingsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ui.AboutActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ui.NineGridSettingsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>

</manifest>
